{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"files": {
		"includes": [
			"src/base/**",
			"src/modules/**",
			"build/**",
			"tests/**",
			"!tests/reference",
			"vite.config.ts"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"assist": {
		"enabled": true
	}
}
