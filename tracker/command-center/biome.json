{
	"files": {
		"includes": [
			"src/base/**",
			"src/modules/**",
			"build/**",
			"tests/**",
			"!tests/reference",
			"vite.config.ts"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noControlCharactersInRegex": "off",
				"noAssignInExpressions": "off"
			}
		}
	},
	"assist": {
		"enabled": true
	}
}
